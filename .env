# ==============================================================================
# SKETCHCMS ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH HỆ THỐNG & DATABASE (system/configs/init.php)
# ------------------------------------------------------------------------------
APP_DEBUG="true"
APP_TIMEZONE="Asia/Ho_Chi_Minh"

DB_HOST="localhost"
DB_USER="root"
DB_PASS=""
DB_NAME="sketchcms"

USER_BOT="SystemBOT"
NEWS_ID="1"

SECOND_PASSWORD="244466666"
E2E_SECRET_KEY="SketchCMS_E2E_localhost"

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH WEBSITE & SEO (system/configs/autoload/system.php -> app)
# ------------------------------------------------------------------------------
APP_NAME="LAB302"
APP_DESCRIPTION="từng bước vững vàng, mở lối tương lai"
APP_KEYWORD="lab302, huce, nuce, sketchcms"

SITE_SCHEME="http://"
SITE_HOST="sketchcms.test"
SITE_PATH=""

DEFAULT_TEMPLATE="default"
INSTALLED_MODULES="custom_headless"

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH DANH SÁCH & QUẢN TRỊ (PostList, UserList, Manager)
# ------------------------------------------------------------------------------
POST_LIST_ORDER_BY="id,time,update_time,view"
POST_LIST_SORT="asc,desc"

USER_LIST_ORDER_BY="level,xu,post"
USER_LIST_SORT="asc,desc"

MANAGER_ALLOW_COUNTRY="ID,MY,SG,TH,PH,BN,KH,LA,MM,TL,VN"
MANAGER_ASSETS="https://cdn.jsdelivr.net/gh/jesuisnk2/someTPL/sneat-free"

# ------------------------------------------------------------------------------
# 4. QUY TẮC ĐỊNH TUYẾN URL (url_rules)
# ------------------------------------------------------------------------------
URL_RULES_REWRITE='{"/faq/terms":{"target":"/home/faq/terms","method":"GET|POST"},"/faq/about":{"target":"/home/faq/about","method":"GET|POST"},"/faq/help":{"target":"/home/faq/help","method":"GET|POST"}}'
URL_RULES_DISABLE="/register"

# ------------------------------------------------------------------------------
# 5. BẢO MẬT & GIỚI HẠN LƯU LƯỢNG (security)
# ------------------------------------------------------------------------------
SECURITY_RATE_LIMIT="2"

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH GỬI THƯ (smtp)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="sketchcms@lab302.ovh"
SMTP_PASS="123123123"
SMTP_ENCRYPT="ssl"
SMTP_FROM_EMAIL="sketchcms@lab302.ovh"
SMTP_FROM_NAME="SketchCMS"

# ------------------------------------------------------------------------------
# 7. CẤU HÌNH LƯU TRỮ TẬP TIN / TELEGRAM (media)
# ------------------------------------------------------------------------------
TELEGRAM_UPLOAD_MODE="direct"
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="your_chat_id_here"
CLOUDFLARE_WORKER_URL="https://your-cloudflare-worker-url.com/upload"
